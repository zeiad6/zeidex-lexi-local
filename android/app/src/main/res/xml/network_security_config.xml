<?xml version="1.0" encoding="utf-8"?>
<!-- The page itself is served from the APK over https. Native requests may reach a user-configured
     model server on the LAN over plain HTTP (Ollama, LM Studio), so cleartext is permitted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
